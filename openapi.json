      }
    },
    "/projects/{projectId}/translations/matrix": {
      "get": {
        "operationId": "TranslationsController_getMatrix",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "번역 매트릭스 반환 (엑셀 테이블처럼)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locales": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "example": "en"
                          },
                          "name": {
                            "type": "string",
                            "example": "English"
                          }
                        }
                      }
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "example": "login.title"
                          },
                          "description": {
                            "type": "string",
                            "example": "로그인 제목"
                          },
                          "translations": {
                            "type": "object",
                            "example": {
                              "en": "Login",
                              "ko": "로그인",
                              "ja": "ログイン"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "프로젝트에 접근할 수 없습니다."
          },
          "404": {
            "description": "프로젝트를 찾을 수 없습니다."
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "프로젝트의 번역을 테이블 형태로 조회 (Key × Locale 매트릭스)",
        "tags": ["번역 (Translations)"]
      }
    },
    "/public/{apiKey}/locales/{localeCode}.json": {
      "get": {
        "description": "프론트엔드에서 API Key와 언어 코드로 번역을 가져옵니다.",
        "operationId": "PublicController_getTranslations",
        "parameters": [
          {
            "name": "apiKey",
            "required": true,
            "in": "path",
            "description": "프로젝트 API Key",
            "schema": {
              "example": "a1b2c3d4e5f6789012345678901234567890123456789012345678901234",
              "type": "string"
            }
          },
          {
            "name": "localeCode",
            "required": true,
            "in": "path",
            "description": "언어 코드",
            "schema": {
              "example": "ko",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "번역 JSON 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "login.title": "로그인",
                    "login.button": "로그인하기",
                    "home.hero.title": "환영합니다"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Project not found 또는 Locale not found"
          }
        },
        "summary": "번역 JSON 다운로드 (인증 불필요)",
        "tags": ["Public API (OTA)"]
      }
    }
  },
  "info": {
    "title": "Verbsync API",
    "description": "다국어(i18n) 관리 SaaS API 문서",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development"
    },
    {
      "url": "https://api.verbsync.com",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "JWT 토큰을 입력하세요",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "사용자 이메일"
          },
          "password": {
            "type": "string",
            "example": "123456",
            "description": "비밀번호 (최소 6자)",
            "minLength": 6
          },
          "name": {
            "type": "string",
            "example": "Alice",
            "description": "사용자 이름"
          }
        },
        "required": ["email", "password", "name"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "사용자 이메일"
          },
          "password": {
            "type": "string",
            "example": "123456",
            "description": "비밀번호"
          }
        },
        "required": ["email", "password"]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "My App",
            "description": "프로젝트 이름"
          },
          "defaultLocale": {
            "type": "string",
            "example": "en",
            "description": "기본 언어 코드",
            "default": "en"
          }
        },
        "required": ["name", "defaultLocale"]
      },
      "CreateLocaleDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ko",
            "description": "언어 코드 (ISO 639-1 또는 BCP 47)"
          },
          "name": {
            "type": "string",
            "example": "한국어",
            "description": "언어 이름"
          }
        },
        "required": ["code", "name"]
      },
      "UpdateLocaleStatusDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "활성화 여부"
          }
        },
        "required": ["isActive"]
      },
      "CreateKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "login.title",
            "description": "번역 키 이름 (dot notation)"
          },
          "description": {
            "type": "string",
            "example": "로그인 페이지 제목",
            "description": "키 설명 (선택)"
          }
        },
        "required": ["name"]
      },
      "TranslationUpdateItem": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "login.title",
            "description": "번역 키 이름"
          },
          "locale": {
            "type": "string",
            "example": "ko",
            "description": "언어 코드"
          },
          "value": {
            "type": "string",
            "example": "로그인",
            "description": "번역 값"
          }
        },
        "required": ["key", "locale", "value"]
      },
      "UpdateTranslationsDto": {
        "type": "object",
        "properties": {
          "updates": {
            "description": "업데이트할 번역 목록",
            "example": [
              {
                "key": "login.title",
                "locale": "en",
                "value": "Log in"
              },
              {
                "key": "login.title",
                "locale": "ko",
                "value": "로그인"
              }
            ],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslationUpdateItem"
            }
          }
        },
        "required": ["updates"]
      }
    }
  }
}
