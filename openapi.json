          }
        ],
        "summary": "번역 일괄 업데이트 (upsert)",
        "tags": ["번역 (Translations)"]
      },
      "get": {
        "operationId": "TranslationsController_findAll",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "번역 목록 반환"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "프로젝트에 접근할 수 없습니다."
          },
          "404": {
            "description": "프로젝트를 찾을 수 없습니다."
          }
        },
        "security": [
