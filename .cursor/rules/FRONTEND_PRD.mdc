### 컴포넌트 구조 (Translations 페이지)

**`TranslationTable.tsx`** (메인 컴포넌트)

```tsx
import { useTranslationMatrix } from "@/hooks/useTranslations";
import { EditableCell } from "./EditableCell";

export function TranslationTable({ projectId }: { projectId: string }) {
  const { data: matrix, isLoading } = useTranslationMatrix(projectId);
  const [changes, setChanges] = useState<Record<string, string>>({});

  if (isLoading) return <Skeleton />;

  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>Key</TableHead>
          {matrix.locales.map((locale) => (
            <TableHead key={locale.code}>
              {locale.name} ({locale.code})
            </TableHead>
          ))}
        </TableRow>
      </TableHeader>
      <TableBody>
        {matrix.rows.map((row) => (
          <TableRow key={row.key}>
            <TableCell>
              <div className="font-medium">{row.key}</div>
              {row.description && (
                <div className="text-xs text-gray-500">{row.description}</div>
              )}
            </TableCell>
            {matrix.locales.map((locale) => (
              <EditableCell
                key={`${row.key}-${locale.code}`}
                value={row.translations[locale.code] || ""}
                onChange={(value) => {
                  const changeKey = `${row.key}|${locale.code}`;
                  setChanges({ ...changes, [changeKey]: value });
                }}
              />
            ))}
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}
```

**`EditableCell.tsx`** (편집 가능한 셀)

```tsx
export function EditableCell({
  value,
  onChange,
}: {
  value: string;
  onChange: (value: string) => void;
}) {
  const [isEditing, setIsEditing] = useState(false);
  const [localValue, setLocalValue] = useState(value);

  return (
    <TableCell
      onDoubleClick={() => setIsEditing(true)}
      className={cn(
        !value && "bg-gray-100",
        localValue !== value && "bg-yellow-100"
      )}
    >
      {isEditing ? (
        <Input
          value={localValue}
          onChange={(e) => setLocalValue(e.target.value)}
          onBlur={() => {
            setIsEditing(false);
            onChange(localValue);
          }}
          autoFocus
        />
      ) : (
        <span>{value || "(비어있음)"}</span>
      )}
    </TableCell>
  );
}
```

